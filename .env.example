# ============================
# 基本設定
# ============================

# アプリケーション設定
FLASK_ENV=development
SECRET_KEY=your-super-secret-key-change-in-production
ENCRYPTION_KEY=your-encryption-key-for-secrets

# JWT認証設定
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================
# データベース設定
# ============================

# PostgreSQL設定
DB_HOST=postgres
DB_PORT=5432
DB_NAME=devin_ai_clone
DB_USER=postgres
DB_PASSWORD=your-secure-database-password
DB_SSL_MODE=prefer

# データベースURL（自動構築されるため通常は不要）
# DATABASE_URL=postgresql://postgres:password@postgres:5432/devin_ai_clone

# ============================
# Redis設定（セッション・キャッシュ用）
# ============================

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your-secure-redis-password
REDIS_DB=0

# Redis URL（自動構築されるため通常は不要）
# REDIS_URL=redis://:password@redis:6379/0

# ============================
# AIモデル設定
# ============================

# Qwen モデル設定
QWEN_MODEL_PATH=/models/qwen-4b
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.7

# OpenAI API設定（フォールバック用）
OPENAI_API_KEY=your-openai-api-key-if-using
OPENAI_API_BASE=https://api.openai.com/v1

# ============================
# Git連携設定
# ============================

GIT_DEFAULT_BRANCH=main
GIT_AUTHOR_NAME=Devin AI Clone
GIT_AUTHOR_EMAIL=devin@ai-clone.local

# ============================
# セキュリティ設定
# ============================

# CORS設定（本番環境では特定のドメインに制限）
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,https://your-domain.com

# セッション設定
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax

# ============================
# 外部サービス設定
# ============================

# Docker Secrets（本番環境）
# Docker Secretsを使用する場合、以下のファイルが /run/secrets/ に配置される
# - jwt_secret_key
# - db_password
# - redis_password
# - encryption_key

# HashiCorp Vault設定
VAULT_ADDR=https://vault.your-domain.com:8200
VAULT_TOKEN=your-vault-token
VAULT_SECRET_PATH=secret/devin-ai-clone

# AWS Secrets Manager設定
AWS_DEFAULT_REGION=us-east-1
AWS_SECRET_NAME=devin-ai-clone-secrets
# AWS認証情報は IAM Role または環境変数で設定
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# ============================
# 監視・ログ設定
# ============================

# ログレベル
LOG_LEVEL=INFO

# Prometheus監視
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Sentry エラー追跡
SENTRY_DSN=your-sentry-dsn-if-using

# ============================
# パフォーマンス設定
# ============================

# ワーカー設定
WORKERS=4
WORKER_CONNECTIONS=1000

# タイムアウト設定
REQUEST_TIMEOUT=30
WEBSOCKET_TIMEOUT=300

# ============================
# 開発環境専用設定
# ============================

# デバッグ設定
DEBUG=true
TESTING=false

# 開発用データベース
DEV_DB_HOST=localhost
DEV_DB_PORT=5432
DEV_DB_NAME=devin_ai_clone_dev
DEV_DB_USER=postgres
DEV_DB_PASSWORD=dev_password

# ============================
# 本番環境設定例
# ============================

# 本番環境では以下の設定を使用
# FLASK_ENV=production
# DEBUG=false
# SESSION_COOKIE_SECURE=true
# CORS_ORIGINS=https://your-production-domain.com
# DB_SSL_MODE=require

# ============================
# セキュリティ注意事項
# ============================

# 1. 本番環境では必ず強力なパスワードを使用してください
# 2. SECRET_KEY と JWT_SECRET_KEY は十分に長く、ランダムな値を使用してください
# 3. データベースパスワードは定期的に変更してください
# 4. CORS_ORIGINS は本番環境では特定のドメインに制限してください
# 5. SSL/TLS を有効にし、HTTPS を使用してください
# 6. 機密情報は Docker Secrets や Vault などのセキュアな方法で管理してください

# ============================
# 設定生成コマンド例
# ============================

# 強力なシークレットキーを生成:
# python -c "import secrets; print(secrets.token_urlsafe(32))"

# パスワードを生成:
# python -c "import secrets; print(secrets.token_urlsafe(16))"

